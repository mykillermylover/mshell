{
    "dependencies": {
        "ags": "*",
        "gnim": "*"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/node": "^22.20.5",
        "@typescript-eslint/eslint-plugin": "^8.24.0",
        "@typescript-eslint/parser": "^8.24.0",
        "eslint": "^9.20.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "prettier": "^3.5.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.0"
    },
    "main": "app.tsx",
    "name": "mshell-dev",
    "scripts": {
        "types": "ags types -d .",
        "build": "npm run bundle && chmod +x ./build/mshell-dev",
        "update-binary": "mkdir -p \"$HOME/.bin\" && ln -sf \"$PWD/scripts/run.sh\" \"$HOME/.bin/mshell-dev\"",
        "build-and-update": "npm run build && npm run update-binary",
        "bundle": "mkdir -p build && ags bundle app.tsx ./build/mshell-dev",
        "lint": "eslint --ignore-pattern '@girs/**'",
        "lint-fix": "eslint --ignore-pattern '@girs/**' --fix",
        "test": "node --import ./tests/support/resolve.ts --test tests/*.test.ts",
        "dev": "bash './dev.sh'"
    },
    "type": "module"
}
